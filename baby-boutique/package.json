{
  "name": "baby-boutique",
  "version": "0.1.0",
  "private": true,
  "description": "Handmade baby knitwear & dolls e-commerce: Express + Prisma + PostgreSQL storefront and admin dashboard.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@netlify/aws-lambda-compat": "2.0.4",
    "@netlify/blobs": "11.1.12",
    "@netlify/database": "2.0.4",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cloudinary": "2.11.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.1.0",
    "multer": "2.5.0",
    "otplib": "12.0.1",
    "qrcode": "1.5.4",
    "serverless-http": "4.0.0",
    "sharp": "0.35.5",
    "stripe": "18.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supertest": "7.1.4"
  }
}
