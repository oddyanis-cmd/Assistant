{
  "name": "baby-boutique",
  "version": "0.1.0",
  "private": true,
  "description": "Handmade baby knitwear & dolls e-commerce: Express + Prisma + PostgreSQL storefront and admin dashboard.",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cloudinary": "2.5.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.0.1",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "sharp": "0.34.4",
    "stripe": "18.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supertest": "7.1.4"
  }
}
