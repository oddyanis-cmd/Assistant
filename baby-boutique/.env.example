# ---- Core ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/boutique?schema=public"
SESSION_TTL_DAYS=14
# true behind HTTPS (required in production)
COOKIE_SECURE=false
# true when running behind a reverse proxy / load balancer (Render, Railway, Fly, Nginx...)
TRUST_PROXY=false

# ---- Payments ----
# Comma-separated, in display order. "dev" = fake test gateway, refused when NODE_ENV=production.
# A provider only appears at checkout if its credentials below are also set.
PAYMENT_PROVIDERS=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# PayPal cannot charge in QAR: orders are converted to this currency at this rate (1 QAR = x).
PAYPAL_CURRENCY=USD
PAYPAL_FX_RATE=0.2747

# ---- Media ----
# local (development only) | cloudinary
MEDIA_PROVIDER=local
MEDIA_UPLOAD_DIR=uploads
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ---- Seed: first administrator ----
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase
