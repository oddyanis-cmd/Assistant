# Anthropic API key used server-side (src/app/api/analyze/route.ts -> lib/engine/report.ts)
# to generate the AI-written narrative report. Never exposed to the client.
#
# Optional: when unset, /pro still works — the engine computes and returns all
# real numbers, and the report is a deterministic "sample" narrative built from
# those same verified numbers, so the full UI/format is testable before billing
# is wired up.
ANTHROPIC_API_KEY=

# Optional: Anthropic model id used for report generation.
# Defaults to "claude-sonnet-5" when unset (see lib/engine/report.ts).
ANALYSIS_MODEL=claude-sonnet-5
